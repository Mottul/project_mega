{
  "name": "mottulbox",
  "productName": "Mottulbox",
  "version": "0.1.0",
  "private": true,
  "description": "Plattformuebergreifende AV-Werkzeug-App (Video-Player, Video-Konverter, Medien-Info, Testbild, ...)",
  "author": "Matthias",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fetch-electron-bin.mjs && node scripts/download-ffmpeg.mjs --max-age 7 && electron-vite dev",
    "start": "node scripts/fetch-electron-bin.mjs && node scripts/download-ffmpeg.mjs --max-age 7 && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/fetch-electron-bin.mjs && node scripts/download-ffmpeg.mjs --max-age 7 && electron-vite build && node e2e/run.mjs",
    "e2e:run": "node scripts/fetch-electron-bin.mjs && node e2e/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-filenames.mjs",
    "check:refs": "node scripts/check-doc-refs.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "ndi:setup": "node scripts/setup-ndi.mjs",
    "ff:fetch": "node scripts/download-ffmpeg.mjs",
    "ff:update": "node scripts/download-ffmpeg.mjs --force",
    "electron:bin": "node scripts/fetch-electron-bin.mjs",
    "package": "node -e \"for (const d of ['dist/.icon-ico','dist/.icon-set']) require('node:fs').rmSync(d,{recursive:true,force:true})\" && node scripts/download-ffmpeg.mjs --max-age 1 && npm run ff:fetch && npm run build && npx --yes electron-builder@26",
    "pwa:dev": "vite --config vite.pwa.config.ts",
    "pwa:build": "vite build --config vite.pwa.config.ts",
    "pwa:preview": "vite preview --config vite.pwa.config.ts --host",
    "package:dir": "npm run build && npx --yes electron-builder@26 --dir"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.9.0",
    "electron-vite": "^6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "0.577.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zustand": "5.0.15"
  }
}
