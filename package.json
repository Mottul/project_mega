{
  "name": "megatoolbox",
  "productName": "MegaToolBox",
  "version": "0.1.0",
  "private": true,
  "description": "Plattformuebergreifende AV-Werkzeug-App (HAP-Konverter, Manuals-Bibliothek, ...)",
  "author": "Matthias",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "ndi:setup": "node scripts/setup-ndi.mjs",
    "ff:fetch": "node scripts/download-ffmpeg.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "electron:bin": "node scripts/fetch-electron-bin.mjs",
    "postinstall": "node scripts/rebuild-native.mjs && node scripts/fetch-electron-bin.mjs",
    "package": "npm run ff:fetch && npm run build && npx --yes electron-builder@26",
    "package:dir": "npm run build && npx --yes electron-builder@26 --dir"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^40.10.2",
    "electron-vite": "^5.0.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.62.1",
    "vite": "^7.3.3",
    "vitest": "4.1.9",
    "zustand": "^5.0.2"
  }
}
