# Sicherheits-/Reproduzierbarkeits-Defaults (siehe docs/SICHERHEIT.md)
engine-strict=true
# Neu hinzugefuegte Pakete exakt pinnen (keine ungewollten Caret-Spruenge)
save-exact=true
fund=false
# Keine Install-Skripte von Abhaengigkeiten (haeufigster Angriffsweg, docs/SICHERHEIT.md). Keines
# unserer Pakete braucht eines: better-sqlite3 bringt fertige Binaries mit (sein binding.gyp
# loest bei npm ci sonst trotz "gypfile": false einen node-gyp-Bau aus), die Electron-Binary
# holt scripts/fetch-electron-bin.mjs (in dev, start und e2e eingebaut).
# Folge: npm fuehrt auch keine pre-/post-Skripte aus -- package.json hat deshalb keine.
ignore-scripts=true
